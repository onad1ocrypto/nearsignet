# ============================================================
# NearSignet Web Configuration (.env.example)
# Zero secrets are required to run, test, or judge NearSignet!
# ============================================================

# Live NEAR Testnet Escrow Contract & RPC (public defaults work out of the box)
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_NEAR_CONTRACT_ID=nearsignet-protocol.testnet
NEXT_PUBLIC_NEAR_VERIFIER_ID=verifier.nearsignet-protocol.testnet
NEXT_PUBLIC_NEAR_USD_RATE=5

# Optional: NEAR AI Cloud / OpenAI-compatible inference key for Contract & Mediator Agents.
# When omitted, NearSignet automatically uses its deterministic multi-language rule engine.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1

# Optional: Scoped Function-Call Access Key on verifier.nearsignet-protocol.testnet
# (Strictly restricted on-chain to ["submit_verification", "propose_mediation"], 0.25 NEAR gas cap)
NEAR_VERIFIER_SCOPED_KEY=

# Optional: Demo Testnet Relayer for server-assisted Testnet sandboxes (Testnet ONLY, never mainnet)
NEAR_DEMO_CLIENT_ID=
NEAR_DEMO_CLIENT_KEY=

# Optional: HMAC secret for signed session cookies (ephemeral per-boot secret used if omitted)
SESSION_SECRET=
